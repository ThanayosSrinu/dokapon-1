; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Crownroad"
run/main_scene="res://ui/menu/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.03, 0.04, 0.12, 1)
boot_splash/show_image=false
config/icon="res://assets/custom/icon.png"

[autoload]

EventBus="*res://autoload/EventBus.gd"
GameState="*res://autoload/GameState.gd"
Database="*res://autoload/Database.gd"
Sound="*res://autoload/Sound.gd"
Settings="*res://autoload/Settings.gd"
PadInput="*res://autoload/PadInput.gd"
Tips="*res://ui/kit/Tips.gd"
Screens="*res://ui/kit/Screens.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

[gui]

theme/custom="res://ui/kit/kit_theme.tres"

